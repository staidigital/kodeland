# Kopier til .env.local og fyll inn verdier fra Supabase:
# Project Settings → API Keys / Data API

NEXT_PUBLIC_SUPABASE_URL=https://<prosjekt-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Hemmelig! Kun på serveren. Aldri i NEXT_PUBLIC_-variabler, aldri i chat eller git.
SUPABASE_SECRET_KEY=sb_secret_...

# Hemmelig! Krypterer studentpassord i databasen (32 byte, base64). Lag en med:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
# Bytt den aldri etter at studenter er laget – da kan ikke de lagrede passordene leses.
STUDENT_PASSORD_NOKKEL=
